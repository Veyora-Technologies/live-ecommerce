# Resolved relative to prisma/schema.prisma, so this file lands at prisma/prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"
# Generate with: openssl rand -hex 32  (32+ characters required in production)
JWT_SECRET=""
NEXT_PUBLIC_APP_NAME="Live"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Defaults to demo/sample mode (persistent disclosure banner). Production mode is deliberately blocked
# by src/lib/env.ts until the database provider/migrations and launch controls are reviewed.
LIVE_DATA_MODE="demo"
# Only for destructive local/CI sample seeds; generate fresh random values and never use in production.
# LIVE_ALLOW_DEMO_SEED="1"
# LIVE_DEMO_USER_PASSWORD=""
# LIVE_DEMO_ADMIN_PASSWORD=""

# --- Request boundary ---
# Number of reverse proxies/CDN hops in front of the app. Rate limiting and audit
# IP hashes count X-Forwarded-For from the RIGHT by this many entries, so a client
# cannot spoof its way into a fresh rate-limit bucket. Use 0 when the app is
# exposed directly to the internet (forwarded headers are then ignored).
# TRUSTED_PROXY_HOPS="1"

# Separate key for hashing IP addresses in audit logs. Falls back to JWT_SECRET
# when unset; set it explicitly so rotating the JWT key does not invalidate every
# stored IP hash.
# IP_HASH_SECRET=""

# Required to read /api/metrics (bearer token). The endpoint returns 503 when
# unset rather than exposing cross-tenant counters.
# METRICS_TOKEN=""

# --- Jobs / cron (required in production) ---
# CRON_SECRET="long-random-string"   # sent as x-cron-secret to /api/jobs/*

# --- Live Assist ---
# ASSIST_ENABLED="true"              # set "false" to disable; core UI works without it
# OPENAI_API_KEY=                    # optional: only if you add an LLM layer (must stay tool-grounded)

# --- Camera / vision (§3.2) — interface stays honest until set ---
# VISION_PROVIDER="google-vision"
# VISION_API_KEY=

# --- Maps / routing (distance works today via coordinates) ---
# MAPBOX_TOKEN=

# --- Notifications (in-app works today) ---
# An API key alone does not send email in this build. Password-reset email returns unavailable until
# a real sender adapter, verified From address/domain, delivery handling, and owner support path exist.
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# WHATSAPP_TOKEN=

# --- Payments (paid plans return 503 until set) ---
# PAYSTACK_SECRET_KEY=
# STRIPE_SECRET_KEY=

# --- Integrations / encrypted secrets ---
# Required in production for webhook/provider secret encryption (32+ random characters; back up securely).
# LIVE_SECRET_ENCRYPTION_KEY=
# POS_PROVIDER=
# DELIVERY_PROVIDER=

# Local/CI integration test server only — never set in a deployed environment.
# The source also requires NODE_ENV=production, LIVE_DATA_MODE=demo, and a file-backed SQLite DATABASE_URL.
# LIVE_TEST_RELAXED_RATE_LIMITS="1"
