{
  "name": "live",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "node scripts/check-eslint-baseline.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "npm run db:seed:geography && npm run db:seed:marketplace && tsx prisma/seed.ts && npm run marketplace:backfill",
    "db:seed:v2": "npm run db:seed:marketplace && tsx prisma/seed-v2.ts && npm run marketplace:backfill",
    "marketplace:backfill": "tsx prisma/backfill-marketplace-listings.ts",
    "db:push": "prisma db push",
    "db:seed:v3": "tsx prisma/seed-v3.ts",
    "db:seed:geography": "tsx prisma/seed-geography.ts",
    "db:seed:marketplace": "tsx prisma/seed-marketplace-categories.ts",
    "db:encrypt-secrets": "tsx scripts/encrypt-existing-secrets.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "otplib": "^12.0.1",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
